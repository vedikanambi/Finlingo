CFPB_DATASET=Mouwiya/cfpb-consumer-complaints
DATASET_REVISIONS_JSON={"dvgodoy/CUAD_v1_Contract_Understanding_clause_classification": "2647c92f634569acbdfbd694ad5488293c55b3f7", "urialon/converted_contract_nli": "c8c6e2fa95912a7ce76409d5b007ce949edcf7b5", "stanfordnlp/snli": "cdb5c3d5eed6ead6e5a341c8e56e669bb666725b", "PatronusAI/financebench": "e04404e3a97f69f79c14d42f24981a1c9c3bcd18", "Mouwiya/cfpb-consumer-complaints": "038f8f8b18879c9384abfee5d0b685b00c03b3cf", "gbharti/finance-alpaca": "c88d3d5e7e2c7cab9f11a56f27bd5ba3ed68f075"}
MODEL_REVISIONS_JSON={"BAAI/bge-small-en-v1.5": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a", "MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli": "b3546ea6b0346eb6f8d5d68b13c7dc6d0376b3d7", "ProsusAI/finbert": "4556d13015211d73dccd3fdd39d39232506f3e43", "Qwen/Qwen2.5-1.5B-Instruct": "989aa7980e4cf806f80c7fef2b1adb7bc71aa306", "Qwen/Qwen2.5-3B-Instruct": "aa8e72537993ba99e69dfaafa59ed015b17504d1", "answerdotai/ModernBERT-large": "45bb4654a4d5aaff24dd11d4781fa46d39bf8c13", "cross-encoder/ms-marco-MiniLM-L-12-v2": "7b0235231ca2674cb8ca8f022859a6eba2b1c968", "cross-encoder/ms-marco-MiniLM-L-6-v2": "c5ee24cb16019beea0893ab7796b1df96625c6b8", "roberta-large": "722cf37b1afa9454edce342e7895e588b6ff1d59", "tasksource/ModernBERT-large-nli": "ca476cb923a8637073d4ceb0f19f7fc236e260d4"}

# Add private tokens only in your own .env, never here.
HF_TOKEN=

# ------------------------------------------------------------------
# Local Ollama inference and embeddings
# ------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b-instruct is the deployed judge/S5 model -- benchmarked stronger
# than mistral:7b-instruct on this project's strict evidence-grounding task
# (see reports/proposal_gap_analysis.md).
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=28672
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=2m
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
SILVER_JUDGE_PROVIDER=ollama
SILVER_REGENERATION_PROVIDER=ollama

# CUAD (a B2B commercial-contract corpus) cannot supply "Data Sharing" clauses
# at all and only sparsely supplies "Penalty Clause". These external pools are
# independently sourced, human- or machine-reviewed records that make the FLB
# 6-class benchmark achievable without relaxing any quality gate.
FLB_EXTERNAL_SILVER_ENABLED=true
FLB_EXTERNAL_GOLD_ENABLED=true

# ---------------------------------------------------------------------------
# Deployed pipeline configuration (this is the config the reported numbers
# in reports/final_results.json were produced with -- do not change these
# without re-running the evaluation)
# ---------------------------------------------------------------------------

# S5 (risk classifier prompted fallback) and S2 (simplifier) generation
# backends. S2 MUST be "local", not "ollama": routing S2 through Ollama
# caused every multi-hour hang encountered during development (S2 retries a
# clause up to 8 times, each a separate Ollama call with a long timeout --
# one slow clause could hang for hours). Keep it local.
S5_GENERATION_BACKEND=ollama
S2_GENERATION_BACKEND=local

# Required because S2_GENERATION_BACKEND=local runs the base Qwen2.5-1.5B
# zero-shot (no fine-tuned SIMPLIFIER_ADAPTER exists for this stage).
ALLOW_BASE_MODELS=true

# S6 faithfulness verifier. The fine-tuned adapter below exists and is a real,
# measured improvement on short FaithBench-style pairs (+0.038 balanced
# accuracy, see reports/final_results.json), but backend/app/core/config.py
# sets verifier_use_base_model=True, so the DEPLOYED pipeline actually runs
# the base (non-adapted) DeBERTa-v3-large model for RQ3 scoring -- the
# fine-tuned adapter under-performed specifically on this project's long
# regulatory-chunk premises (see proposal_gap_analysis.md section 8 for the
# full comparison). The adapter is kept for the FaithBench ablation only.
VERIFIER_ADAPTER=models/stage6_verifier_v3_financial
VERIFIER_REQUIRE_ADAPTER=false
VERIFIER_CALIBRATION_PATH=reports/verifier_faithbench_calibration.json
MODERNBERT_ADAPTER=models/stage6_modernbert_verifier

# Achievable FLB build: `flb-plan --accept` freezes reports/flb_plan.json
# (91 clauses across all 6 classes, 0 quality gates relaxed).
FLB_MODE=achievable
FLB_PLAN_MIN_PER_CLASS=10

SILVER_LABEL_BATCH_SIZE=4
SILVER_LOCAL_MAX_NEW_TOKENS=2048
SILVER_LABEL_CACHE_DIR=models/silver_cache/flb_candidates
SYNTHETIC_NLI_BATCH_SIZE=3
SYNTHETIC_NLI_CONCURRENCY=1
VERIFIER_TRAIN_SAMPLES=5000
VERIFIER_VALIDATION_SAMPLES=999

# Reproducibility pins: run `python main.py pin-revisions` once and paste the
# two lines it prints here. `preflight --final` fails if these are empty.
# DATASET_REVISIONS_JSON={"...": "..."}
# MODEL_REVISIONS_JSON={"...": "..."}

# Verifier-v3 attachment proof / FaithBench reproduction gates
# ADAPTER_PROOF_MIN_DELTA=0.02
# FAITHBENCH_REPRODUCTION_TOLERANCE=0.03

# Training throughput
ENABLE_TF32=true
USE_LENGTH_GROUPED_BATCHING=true
DATALOADER_NUM_WORKERS=2

# S5 risk classifier: prompted-only reaches macro-F1 0.563 (below the 0.75
# target). The proposal's target does not actually mandate a no-fine-tuning
# constraint for S5 on direct re-reading, so a genuinely fine-tuned LoRA
# classifier (legal-bert-base-uncased, v5) was trained and IS deployed here --
# real FLB macro-F1 0.79, beating both the target and the prompted baseline.
# See reports/final_results.json for the full breakdown.
RISK_CLASSIFIER_BACKEND=trained
RISK_CLASSIFIER_ADAPTER=models/stage5_risk_classifier_v5

SIMPLIFIER_RETRIES=7
SIMPLIFIER_MIN_SEMANTIC_ENTAILMENT=0.72

# Consolidated final run output
SUBMISSION_DIR=reports/submission
